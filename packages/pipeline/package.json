{
  "name": "zomboid-models-pipeline",
  "version": "1.0.0",
  "description": "Converts Project Zomboid (Build 42) character assets from a game or dedicated server install into web-ready files for zomboid-models",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zomboid-models": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "fengari": "0.1.5",
    "three": "0.185.0",
    "zomboid-models": "1.0.0"
  },
  "keywords": [
    "project-zomboid",
    "zomboid",
    "gltf",
    "directx-x",
    "asset-pipeline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kentucky-Vibes/zomboid-models.git",
    "directory": "packages/pipeline"
  },
  "homepage": "https://github.com/Kentucky-Vibes/zomboid-models#readme",
  "bugs": "https://github.com/Kentucky-Vibes/zomboid-models/issues",
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10"
  },
  "sideEffects": false
}

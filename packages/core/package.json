{
  "name": "zomboid-models",
  "version": "1.0.0",
  "description": "Render Project Zomboid (Build 42) characters in the browser with three.js",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "ajv": "8.20.0",
    "three": "0.185.1"
  },
  "keywords": [
    "project-zomboid",
    "zomboid",
    "three",
    "threejs",
    "webgl",
    "character",
    "3d"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kentucky-Vibes/zomboid-models.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Kentucky-Vibes/zomboid-models#readme",
  "bugs": "https://github.com/Kentucky-Vibes/zomboid-models/issues",
  "engines": {
    "node": ">=22.12"
  }
}
